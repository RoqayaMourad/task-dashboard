{
	auto_https off
}

:{$PORT:3000} {
	encode gzip

	# Strips /api before forwarding since JSON Server serves routes at its root.
	handle_path /api/* {
		reverse_proxy {$API_INTERNAL_URL}
	}

	# Serves the Angular build, falling back to index.html for client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
